<ContainerButton xmlns="https://spacestation14.io"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:sfControls="clr-namespace:Content.Client._Starfall.UserInterface.Controls"
                 HorizontalExpand="True"
                 MinHeight="96">
    <sfControls:TrueCenterContainer HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical" SeparationOverride="9">
            <Label Name="ChannelName" StyleClasses="SignalConsoleName" HorizontalAlignment="Center" />
            <Label Name="ActionText" StyleClasses="SignalConsoleAction" HorizontalAlignment="Center" />
        </BoxContainer>
    </sfControls:TrueCenterContainer>

    <Label Name="CornerLabel" StyleClasses="SignalConsoleCorner" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" />
</ContainerButton>
