<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'signal-console-title'}"
                      MinSize="600 540">
    <BoxContainer Orientation="Vertical">
            <BoxContainer Orientation="Vertical" SeparationOverride="12" Margin="18" VerticalExpand="True" HorizontalExpand="True">
                <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                    <ScrollContainer Name="ChannelScroll" VerticalExpand="True" HorizontalExpand="True" ReservesSpace="False" HScrollEnabled="False" HScrollBarHidden="True">
                        <GridContainer Name="Channels" Columns="2" HSeparationOverride="10" VSeparationOverride="10" HorizontalExpand="True" />
                    </ScrollContainer>

                    <Label Text="{Loc 'signal-console-empty-title'}" Name="EmptyState" Visible="False" ReservesSpace="False" HorizontalExpand="True" VerticalExpand="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </BoxContainer>
            </BoxContainer>

            <BoxContainer HorizontalExpand="True" SetHeight="34">
                <controls:StripeBack HasBottomEdge="False" HasMargins="False" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Text="{Loc 'signal-console-footer-left'}" VerticalAlignment="Center" Margin="6 0" StyleClasses="PdaContentFooterText" />
                        <Control HorizontalExpand="True" />
                        <Button Name="EditButton" Text="{Loc 'signal-console-edit'}" MinWidth="72" Margin="4 3" />
                    </BoxContainer>
                </controls:StripeBack>
            </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
